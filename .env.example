# AURA-NSE Pro Environment Variables
# Copy to .env and configure secrets

# Application Core
APP_ENV=development
APP_SECRET_KEY=aura_super_secret_master_key_change_in_production_32b_hex
FERNET_ENCRYPTION_KEY= # Base64 32-byte key for encrypting API keys at rest
DATABASE_URL=sqlite:///./backend/aura_nse.db
TIMEZONE=Asia/Kolkata
PORT=8000
HOST=0.0.0.0

# Initial Admin Auth
ADMIN_USERNAME=investor
